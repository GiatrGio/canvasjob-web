# Public — shipped to the browser. Use the Supabase publishable key, never the secret.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# FastAPI backend base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical site URL used for social preview image metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID. Analytics is loaded only after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Free-tier allowances quoted on the marketing pages (pricing, landing, signup)
# and used as the fallback for a profile row without its own limit. These MIRROR
# the API's FREE_TIER_MONTHLY_LIMIT / FREE_TRACKED_JOBS_LIMIT /
# FREE_TIER_MONTHLY_COVER_LETTER_LIMIT — change both together, or the site
# advertises a number the API won't honour. Inlined at build time (rebuild to
# apply, a restart is not enough).
NEXT_PUBLIC_FREE_EVALUATION_LIMIT=200
NEXT_PUBLIC_FREE_TRACKED_JOB_LIMIT=20
NEXT_PUBLIC_FREE_COVER_LETTER_LIMIT=5
NEXT_PUBLIC_PRO_COVER_LETTER_LIMIT=25

# Server-only comma-separated allowlist for /admin.
ADMIN_EMAILS=you@example.com
